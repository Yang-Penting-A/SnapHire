DEBUG=true

# API
PORT=8000
API_PREFIX=/api

# CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000,https://snaphire.site,https://www.snaphire.site,https://snaphire.up.railway.app

# Feature Flags
ENABLE_EMAIL_POLLING=false
DEV_MODE=false

# Database
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account_name>;AccountKey=<account_key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_CV=cvs

# Gemini AI
GEMINI_API_KEY=<your_gemini_api_key>

# Email IMAP
EMAIL_USER=<your_email@gmail.com>
EMAIL_APP_PASSWORD=<your_app_password>
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true

# Public URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000/api
